{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@perch/shared": ["packages/shared/src"],
      "@perch/shared/*": ["packages/shared/src/*"],
      "@perch/api": ["apps/api/src"],
      "@perch/api/*": ["apps/api/src/*"]
    }
  }
}
